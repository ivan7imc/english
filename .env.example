# Produção (Render): cole aqui a connection string do Neon.
# Neon Console > Connect > Connection string (pooled).
DATABASE_URL=postgresql://USUARIO:SENHA@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

NODE_ENV=production
APP_NAME=English Hub
MAX_UPLOAD_MB=15

# Opcional: cria o primeiro professor na inicialização.
# TEACHER_NAME=Professor
# TEACHER_EMAIL=professor@seudominio.com
# TEACHER_PASSWORD=troque-por-uma-senha-forte

# Alternativa: protege a tela de configuração inicial.
# Em produção, se não houver professor e SETUP_KEY não estiver definido, o setup via web fica bloqueado.
# SETUP_KEY=uma-chave-secreta-para-o-primeiro-acesso

# NÃO ative DEMO_MODE em produção. Ele usa um banco local apenas para demonstração.
DEMO_MODE=false
SEED_DEMO=false
